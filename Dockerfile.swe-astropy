FROM python:3.10-slim
ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1 \
    CFLAGS=-Wno-error=incompatible-pointer-types
RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc g++ python3-dev libcfitsio-dev git \
 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir setuptools==59.8.0 cython==0.29.36 numpy==1.21.6 extension-helpers astropy==5.0.4 pytest hypothesis pytest-doctestplus
WORKDIR /work
COPY benchmarks/astropy_minimal_build.py /opt/xiaopu/astropy_minimal_build.py
COPY benchmarks/official_slice_runner.py /opt/xiaopu/official_slice_runner.py
COPY benchmarks/astropy_slice_entry.py /opt/xiaopu/astropy_slice_entry.py
