# ==============================================================================
# 报一 (Baoyi) Agent Harness - Environment Configuration Contract
# ==============================================================================
# Copy this file to .env and configure your provider API keys and runtime policies:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# 1. Model Provider & API Credentials
# ------------------------------------------------------------------------------
# Primary provider: 'openai' (default) or 'anthropic'
PROVIDER=openai

# OpenAI / DeepSeek / Compatible Provider Settings
OPENAI_API_KEY=your-openai-or-deepseek-api-key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
OPENAI_MAX_TOKENS=4096

# Anthropic Provider Settings (when PROVIDER=anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=4096

# ------------------------------------------------------------------------------
# 2. Reasoning & Thinking Configuration
# ------------------------------------------------------------------------------
# Reasoning effort level: 'off', 'low', 'medium', 'high' (default), 'max'
REASONING_EFFORT=high

# Enable reasoning mode for supported models (1 = enabled, 0 = disabled)
THINKING_ENABLED=1

# ------------------------------------------------------------------------------
# 3. Execution Budget & Resource Caps
# ------------------------------------------------------------------------------
# Maximum agent turns per task invocation
MAX_STEPS=25

# Maximum tool call executions per turn
MAX_TOOL_CALLS=120

# Maximum cumulative token consumption per run
MAX_TOTAL_TOKENS=120000

# Maximum generated output tokens limit
MAX_GENERATED_OUTPUT_TOKENS=120000

# First action generation cap before emitting initial tool call
FIRST_ACTION_OUTPUT_TOKENS=1600

# Strict run budget gate (true for reproducible benchmark runs, false for interactive)
STRICT_RUN_BUDGET=0

# ------------------------------------------------------------------------------
# 4. Security & Command Policies
# ------------------------------------------------------------------------------
# Shell execution permission policy: 'ask' (confirm in GUI/CLI), 'allow' (auto), 'deny'
COMMAND_POLICY=ask

# Maximum timeout in seconds for executing shell commands
MAX_COMMAND_TIMEOUT=600

# API retry count and network timeout (seconds)
API_RETRIES=3
API_TIMEOUT=120.0

# ------------------------------------------------------------------------------
# 5. Workspace, Storage & UI Settings
# ------------------------------------------------------------------------------
# Custom root workspace directory (defaults to ./workspace if not set)
# BAOYI_WORKSPACE=./workspace
# WORKSPACE=./workspace

# Custom persistent state directory (defaults to ~/.baoyi; legacy fallback ~/.xiaopu)
# BAOYI_HOME=~/.baoyi

# Recording evidence level: 'minimal' (milestones), 'audit' (journal), 'research'
BAOYI_RECORD_MODE=audit

# Optional comma-separated model list for CLI / GUI model picker
# BAOYI_MODELS=deepseek-v4-flash,deepseek-chat,gpt-4o,claude-3-5-sonnet-20241022

# GUI Theme ('dark', 'light', 'dracula') and Keymap ('default', 'minimal')
# BAOYI_THEME=dark
# BAOYI_KEYMAP=default
